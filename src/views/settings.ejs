<%- include('partials/header') %>
      <h1>配置</h1>
      <section class="card my-4"><div class="card-body">
        <h2 class="h4">全局设置</h2>
        <form id="settings-form">
          <div class="mb-3"><label class="form-label" for="downloadRoot">下载根目录</label><input class="form-control" id="downloadRoot" readonly aria-describedby="downloadRootHelp"><div class="form-text" id="downloadRootHelp">由部署配置固定，不能在此修改。</div></div>
          <div class="mb-3"><label class="form-label" for="globalCheckIntervalMinutes">全局检查间隔（分钟）</label><input class="form-control" type="number" min="1" step="1" id="globalCheckIntervalMinutes" name="globalCheckIntervalMinutes" required></div>
          <div class="mb-3"><label class="form-label" for="downloadConcurrency">下载并发数</label><input class="form-control" type="number" min="1" step="1" id="downloadConcurrency" name="downloadConcurrency" required></div>
          <div class="alert alert-danger" data-form-error hidden></div><button class="btn btn-primary" type="submit">保存设置</button>
        </form>
      </div></section>
      <section class="card"><div class="card-body">
        <div class="d-flex align-items-start justify-content-between gap-3 mb-3">
          <div>
            <h2 class="h4">代理</h2>
            <p class="text-body-secondary mb-0">代理密码仅以脱敏形式展示；编辑时必须重新输入完整密码。</p>
          </div>
          <button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#proxy-modal" data-proxy-create>新增代理</button>
        </div>
        <div id="proxy-list-error" class="alert alert-danger" hidden></div>
        <div class="table-responsive"><table id="proxy-table" class="table align-middle">
          <thead><tr><th>名称</th><th>协议</th><th>主机</th><th>端口</th><th>用户名</th><th>密码</th><th>操作</th></tr></thead>
          <tbody id="proxy-list"></tbody>
        </table></div>
      </div></section>
      <div class="modal fade" id="proxy-modal" tabindex="-1" aria-labelledby="proxy-modal-title" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered">
          <div class="modal-content">
            <form id="proxy-form" class="proxy-modal-form">
              <div class="modal-header">
                <h2 class="modal-title h5" id="proxy-modal-title">新增代理</h2>
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="关闭"></button>
              </div>
              <div class="modal-body">
                <div class="proxy-field-full"><label class="form-label" for="proxy-name">名称</label><input class="form-control" id="proxy-name" name="name" required></div>
                <div class="proxy-field-full"><label class="form-label" for="proxy-protocol">代理类型</label><select class="form-select" id="proxy-protocol" name="protocol" required><option value="http">HTTP</option><option value="https">HTTPS</option><option value="socks5">SOCKS5</option></select></div>
                <div class="proxy-field-pair">
                  <div><label class="form-label" for="proxy-host">主机地址</label><input class="form-control" id="proxy-host" name="host" placeholder="例如：192.168.1.100" required></div>
                  <div><label class="form-label" for="proxy-port">端口</label><input class="form-control" id="proxy-port" type="number" min="1" max="65535" step="1" name="port" placeholder="例如：1080" required></div>
                </div>
                <div class="proxy-field-pair">
                  <div><label class="form-label" for="proxy-username">用户名</label><input class="form-control" id="proxy-username" name="username" placeholder="代理用户名"></div>
                  <div><label class="form-label" for="proxy-password">密码</label><input class="form-control" id="proxy-password" type="password" name="password" placeholder="代理密码"></div>
                </div>
                <div class="alert alert-danger" data-form-error hidden></div>
              </div>
              <div class="modal-footer">
                <button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">取消</button>
                <button class="btn btn-primary" type="submit" data-proxy-submit>新增代理</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </main>
    <script type="module" src="/public/settings.js"></script>
<%- include('partials/footer') %>
