<%- include('partials/header') %>
      <h1 class="mb-4"><%= t('page.dashboard.title') %></h1>
      <div id="page-error" class="alert alert-danger" hidden></div>
      <div id="channel-summary" class="row g-3" aria-live="polite"></div>
      <section class="mt-4" aria-labelledby="active-tasks-title">
        <div class="task-section-heading d-flex align-items-center gap-2 mb-2">
          <h2 class="task-section-title mb-0" id="active-tasks-title"><%= t('dashboard.activeTasks') %></h2>
          <span id="active-task-count" class="badge rounded-pill text-bg-primary">0</span>
        </div>
        <div class="yt-dlp-tasks-table-shell table-responsive border rounded-4">
          <table class="table yt-dlp-tasks-table align-middle mb-0">
            <thead><tr><th scope="col">ID</th><th scope="col"><%= t('field.type') %></th><th scope="col"><%= t('field.status') %></th><th scope="col"><%= t('field.createdAt') %></th><th scope="col"><%= t('field.startedAt') %></th><th scope="col"><%= t('field.finishedAt') %></th><th scope="col"><%= t('field.failureReason') %></th></tr></thead>
            <tbody id="active-task-list"></tbody>
          </table>
          <div id="active-task-empty" class="yt-dlp-tasks-empty p-5 px-3 border-top text-body-secondary text-center" role="status" hidden><%= t('dashboard.noActiveTasks') %></div>
        </div>
      </section>
      <section class="mt-4" aria-labelledby="terminal-tasks-title">
        <div class="task-section-heading d-flex align-items-center gap-2 mb-2">
          <h2 class="task-section-title mb-0" id="terminal-tasks-title"><%= t('dashboard.finishedTasks') %></h2>
          <span id="terminal-task-count" class="badge rounded-pill text-bg-secondary">0</span>
        </div>
        <div class="yt-dlp-tasks-table-shell table-responsive border rounded-4">
          <table class="table yt-dlp-tasks-table align-middle mb-0">
            <thead><tr><th scope="col">ID</th><th scope="col"><%= t('field.type') %></th><th scope="col"><%= t('field.status') %></th><th scope="col"><%= t('field.createdAt') %></th><th scope="col"><%= t('field.startedAt') %></th><th scope="col"><%= t('field.finishedAt') %></th><th scope="col"><%= t('field.failureReason') %></th></tr></thead>
            <tbody id="terminal-task-list"></tbody>
          </table>
          <div id="terminal-task-empty" class="yt-dlp-tasks-empty p-5 px-3 border-top text-body-secondary text-center" role="status" hidden><%= t('dashboard.noFinishedTasks') %></div>
        </div>
      </section>
    </main>
    <script type="module" src="/public/dashboard.js"></script>
    <script type="module" src="/public/yt-dlp-tasks.js"></script>
<%- include('partials/footer') %>
