<%- include('partials/header') %>
      <div class="authorization-page-heading d-flex flex-column flex-lg-row align-items-stretch align-items-lg-end justify-content-between gap-3 mb-4">
        <div>
          <h1><%= t('page.authorizations.title') %></h1>
          <p class="authorization-page-summary"><%= t('authorizations.summary') %></p>
        </div>
        <button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#authorization-modal" data-authorization-create><%= t('authorizations.create') %></button>
      </div>

      <div id="authorization-page-error" class="alert alert-danger" role="alert" hidden></div>

      <div class="alert alert-warning authorization-integration-warning d-grid" role="alert">
        <strong><%= t('authorizations.scope') %></strong>
        <p class="mb-0"><%= t('authorizations.scopeHelp') %></p>
      </div>

      <section class="authorization-list-card overflow-hidden mb-4" aria-labelledby="authorization-list-title">
        <div class="authorization-section-heading">
          <h2 id="authorization-list-title"><%= t('authorizations.configured') %></h2>
          <p><%= t('authorizations.replaceHelp') %></p>
        </div>
        <div class="table-responsive">
          <table class="table align-middle authorization-table">
            <thead>
              <tr><th scope="col"><%= t('field.platform') %></th><th scope="col"><%= t('field.status') %></th><th scope="col"><%= t('field.updatedAt') %></th><th scope="col"><%= t('field.actions') %></th></tr>
            </thead>
            <tbody id="authorization-list"></tbody>
          </table>
        </div>
      </section>

      <section class="authorization-safety-card" aria-labelledby="authorization-safety-title">
        <h2 id="authorization-safety-title"><%= t('authorizations.safety') %></h2>
        <ol>
          <li><%= t('authorizations.safetyExportBeforeLink') %> <a href="https://chromewebstore.google.com/detail/get-cookiestxt-locally/cclelndahbckbenkjhflpdbgdldlbecc" target="_blank" rel="noopener noreferrer">Get cookies.txt LOCALLY</a> <%= t('authorizations.safetyExportAfterLink') %></li>
          <li><%= t('authorizations.safetyUpload') %></li>
          <li><%= t('authorizations.safetyCredential') %></li>
        </ol>
        <p class="mb-0"><strong><%= t('authorizations.safetyConfiguredDisclaimer') %></strong></p>
      </section>

      <div class="modal fade" id="authorization-modal" tabindex="-1" aria-labelledby="authorization-modal-title" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered">
            <form id="authorization-form" class="modal-content authorization-modal-form">
              <div class="modal-header">
                <h2 class="modal-title h5" id="authorization-modal-title"><%= t('authorizations.create') %></h2>
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="<%= t('common.close') %>"></button>
              </div>
              <div class="modal-body d-grid gap-3">
                <div>
                  <label class="form-label" for="authorization-platform"><%= t('field.platform') %></label>
                  <select class="form-select" id="authorization-platform" name="platform" required></select>
                </div>
                <div>
                  <label class="form-label" for="authorization-file"><%= t('authorizations.file') %></label>
                  <input class="form-control" id="authorization-file" name="cookieFile" type="file" accept=".txt,text/plain" required>
                </div>
                <div class="alert alert-danger mb-0" data-form-error role="alert" hidden></div>
              </div>
              <div class="modal-footer">
                <button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal"><%= t('common.cancel') %></button>
                <button class="btn btn-primary" type="submit" data-authorization-submit><%= t('authorizations.create') %></button>
              </div>
            </form>
        </div>
      </div>
    </main>
    <script type="module" src="/public/authorizations.js"></script>
<%- include('partials/footer') %>
