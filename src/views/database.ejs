<%- include('partials/header') %>
      <div class="database-page-heading mb-4">
        <div>
          <p class="database-page-kicker"><%= t('page.database.title') %></p>
          <h1><%= t('page.database.title') %></h1>
          <p class="database-page-summary"><%= t('database.summary') %></p>
        </div>
      </div>
      <div id="database-page-error" class="alert alert-danger" hidden></div>
      <section class="database-workspace d-grid overflow-hidden">
        <aside class="database-table-panel" aria-labelledby="database-table-title">
          <h2 class="m-0 p-3 text-uppercase" id="database-table-title"><%= t('database.tables') %></h2>
          <div id="database-table-list" class="list-group list-group-flush" aria-live="polite"></div>
        </aside>
        <div class="database-query-panel">
          <form id="database-query-form" class="database-query-form d-grid gap-3 p-3">
            <label class="form-label" for="database-sql"><%= t('database.readonlySql') %></label>
            <textarea id="database-sql" class="form-control font-monospace" name="sql" rows="5" required placeholder="SELECT * FROM channels LIMIT 200"></textarea>
            <button id="database-run" class="btn btn-primary" type="submit"><%= t('database.run') %></button>
          </form>
          <div id="database-result" class="database-result p-3 overflow-auto" aria-live="polite">
            <div class="database-result-empty text-center"><%= t('database.prompt') %></div>
          </div>
        </div>
      </section>
    </main>
    <script type="module" src="/public/database.js"></script>
<%- include('partials/footer') %>
