<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= pageTitle %> · VidHarbor</title>
    <link rel="stylesheet" href="/public/main.css">
  </head>
  <body>
    <div class="app-shell">
      <aside id="app-sidebar" class="app-sidebar" aria-label="主导航">
        <a class="sidebar-brand" href="/">
          <span class="brand-mark" aria-hidden="true">VH</span>
          <span>VidHarbor</span>
        </a>
        <nav class="sidebar-nav">
          <a class="sidebar-link<%= currentPath === '/' ? ' active' : '' %>" href="/">总览</a>
          <a class="sidebar-link<%= currentPath === '/downloads' ? ' active' : '' %>" href="/downloads">下载</a>
          <a class="sidebar-link<%= currentPath === '/channels' || currentPath.startsWith('/channels/') ? ' active' : '' %>" href="/channels">频道</a>
          <a class="sidebar-link<%= currentPath === '/notifications' ? ' active' : '' %>" href="/notifications">提醒</a>
          <a class="sidebar-link<%= currentPath === '/settings' ? ' active' : '' %>" href="/settings">配置</a>
          <a class="sidebar-link<%= currentPath === '/database' ? ' active' : '' %>" href="/database">数据库</a>
          <a class="sidebar-link sidebar-guide-link<%= currentPath === '/guide' ? ' active' : '' %>" href="/guide">说明</a>
        </nav>
      </aside>
      <button class="sidebar-backdrop" type="button" data-sidebar-toggle aria-label="关闭菜单"></button>
      <div class="app-content">
        <header class="app-topbar">
          <button class="btn btn-outline-primary d-lg-none" type="button" data-bs-toggle="offcanvas" data-sidebar-toggle aria-controls="app-sidebar">菜单</button>
        </header>
        <main class="page-content">
