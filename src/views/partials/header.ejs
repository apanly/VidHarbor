<!doctype html>
<html lang="<%= language %>">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= pageTitle %> · VidHarbor</title>
    <link rel="icon" href="/public/favicon.svg" type="image/svg+xml">
    <link rel="icon" href="/public/favicon.ico" sizes="any">
    <link rel="apple-touch-icon" href="/public/apple-touch-icon.png">
    <link rel="stylesheet" href="/public/main.css">
    <script id="vidharbor-i18n" type="application/json"><%- i18nJson %></script>
  </head>
  <body>
    <div class="app-shell d-flex">
      <aside id="app-sidebar" class="app-sidebar d-flex flex-column align-self-start" aria-label="<%= t('nav.main') %>">
        <a class="sidebar-brand d-flex align-items-center gap-3" href="/">
          <span class="brand-mark d-inline-grid" aria-hidden="true">VH</span>
          <span>VidHarbor</span>
        </a>
        <nav class="sidebar-nav d-flex flex-column">
          <a class="sidebar-link d-block<%= currentPath === '/' ? ' active' : '' %>" href="/"><%= t('nav.dashboard') %></a>
          <a class="sidebar-link d-block<%= currentPath === '/downloads' ? ' active' : '' %>" href="/downloads"><%= t('nav.downloads') %></a>
          <a class="sidebar-link d-block<%= currentPath === '/channels' || currentPath.startsWith('/channels/') ? ' active' : '' %>" href="/channels"><%= t('nav.channels') %></a>
          <a class="sidebar-link d-block<%= currentPath === '/notifications' ? ' active' : '' %>" href="/notifications"><%= t('nav.notifications') %></a>
          <a class="sidebar-link d-block<%= currentPath === '/authorizations' ? ' active' : '' %>" href="/authorizations"><%= t('nav.authorizations') %></a>
          <a class="sidebar-link d-block<%= currentPath === '/settings' ? ' active' : '' %>" href="/settings"><%= t('nav.settings') %></a>
          <a class="sidebar-link d-block<%= currentPath === '/database' ? ' active' : '' %>" href="/database"><%= t('nav.database') %></a>
          <a class="sidebar-link sidebar-guide-link d-block<%= currentPath === '/guide' ? ' active' : '' %>" href="/guide"><%= t('nav.guide') %></a>
        </nav>
        <%- include('language-switcher') %>
      </aside>
      <button class="sidebar-backdrop d-block d-lg-none" type="button" data-sidebar-toggle aria-label="<%= t('common.closeMenu') %>"></button>
      <div class="app-content">
        <header class="app-topbar d-flex d-lg-none align-items-center">
          <button class="btn btn-outline-primary" type="button" data-bs-toggle="offcanvas" data-sidebar-toggle aria-controls="app-sidebar" aria-label="<%= t('common.menu') %>"><%= t('common.menu') %></button>
        </header>
        <main class="page-content">
