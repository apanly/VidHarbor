<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= pageTitle %> · VidHarbor</title>
    <link rel="icon" href="/public/favicon.svg" type="image/svg+xml">
    <link rel="icon" href="/public/favicon.ico" sizes="any">
    <link rel="apple-touch-icon" href="/public/apple-touch-icon.png">
    <link rel="stylesheet" href="/public/main.css">
  </head>
  <body>
    <div class="app-shell d-flex">
      <aside id="app-sidebar" class="app-sidebar d-flex flex-column align-self-start" aria-label="主导航">
        <a class="sidebar-brand d-flex align-items-center gap-3" href="/">
          <span class="brand-mark d-inline-grid" aria-hidden="true">VH</span>
          <span>VidHarbor</span>
        </a>
        <nav class="sidebar-nav d-flex flex-column">
          <a class="sidebar-link d-block<%= currentPath === '/' ? ' active' : '' %>" href="/">总览</a>
          <a class="sidebar-link d-block<%= currentPath === '/downloads' ? ' active' : '' %>" href="/downloads">下载管理</a>
          <a class="sidebar-link d-block<%= currentPath === '/channels' || currentPath.startsWith('/channels/') ? ' active' : '' %>" href="/channels">频道管理</a>
          <a class="sidebar-link d-block<%= currentPath === '/notifications' ? ' active' : '' %>" href="/notifications">提醒列表</a>
          <a class="sidebar-link d-block<%= currentPath === '/authorizations' ? ' active' : '' %>" href="/authorizations">授权管理</a>
          <a class="sidebar-link d-block<%= currentPath === '/settings' ? ' active' : '' %>" href="/settings">配置管理</a>
          <a class="sidebar-link d-block<%= currentPath === '/database' ? ' active' : '' %>" href="/database">数据库管理</a>
          <a class="sidebar-link sidebar-guide-link d-block<%= currentPath === '/guide' ? ' active' : '' %>" href="/guide">系统说明</a>
        </nav>
      </aside>
      <button class="sidebar-backdrop d-block d-lg-none" type="button" data-sidebar-toggle aria-label="关闭菜单"></button>
      <div class="app-content">
        <header class="app-topbar d-flex d-lg-none align-items-center">
          <button class="btn btn-outline-primary" type="button" data-bs-toggle="offcanvas" data-sidebar-toggle aria-controls="app-sidebar">菜单</button>
        </header>
        <main class="page-content">
