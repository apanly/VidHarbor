<div class="language-switcher d-flex">
  <button class="language-switcher-button" type="button" data-language-switch="zh-CN" aria-pressed="<%= language === 'zh-CN' %>"><%= t('language.zh-CN') %></button>
  <button class="language-switcher-button" type="button" data-language-switch="en" aria-pressed="<%= language === 'en' %>"><%= t('language.en') %></button>
</div>
