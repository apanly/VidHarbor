<%- include('partials/header') %>
      <div class="d-flex align-items-center justify-content-between gap-3 mb-4">
        <h1><%= t('page.channels.title') %></h1>
        <button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#channel-modal" data-channel-create><%= t('channels.create') %></button>
      </div>
      <section>
        <div id="channel-page-error" class="alert alert-danger" role="alert" hidden></div>
        <div id="channel-empty-state" class="channel-empty-state position-relative overflow-hidden text-center" aria-labelledby="channel-empty-title" hidden>
          <div class="channel-empty-mark position-relative d-grid rounded-circle" aria-hidden="true"><span>+</span></div>
          <p class="channel-empty-kicker"><%= t('channels.subscription') %></p>
          <h2 class="mb-0" id="channel-empty-title"><%= t('channels.emptyTitle') %></h2>
          <p class="channel-empty-description"><%= t('channels.emptyHelp') %></p>
          <button class="btn btn-primary" type="button" data-channel-empty-create><%= t('channels.addFirst') %></button>
        </div>
        <div id="channel-list" class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4"></div>
        <nav id="channel-pagination" class="list-pagination" aria-label="<%= t('page.channels.title') %>" hidden></nav>
      </section>
      <div class="modal fade" id="channel-modal" tabindex="-1" aria-labelledby="channel-modal-title" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered">
            <form id="channel-form" class="modal-content">
              <div class="modal-header">
                <h2 class="modal-title h5" id="channel-modal-title"><%= t('channels.create') %></h2>
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="<%= t('common.close') %>"></button>
              </div>
              <div class="modal-body">
                <div class="mb-3"><label class="form-label" for="channel-url"><%= t('channels.url') %></label><input class="form-control" id="channel-url" name="url" required><div class="form-text"><%= t('channels.urlHelp') %> https://space.bilibili.com/3985676</div></div>
                <div class="mb-3"><label class="form-label" for="channel-custom-name"><%= t('channels.customName') %></label><input class="form-control" id="channel-custom-name" name="customName" required></div>
                <div class="mb-3"><label class="form-label" for="channel-proxy"><%= t('field.network') %></label><select class="form-select" id="channel-proxy" name="proxyId"><option value=""><%= t('common.direct') %></option></select></div>
                <div class="mb-3"><label class="form-label" for="channel-authorization"><%= t('channels.authorization') %></label><select class="form-select" id="channel-authorization" name="authorizationPlatform"><option value=""><%= t('channels.noAuthorization') %></option></select><div class="form-text"><%= t('channels.authorizationHelp') %></div></div>
                <div class="mb-3"><label class="form-label" for="channel-check-interval"><%= t('channels.interval') %></label><input class="form-control" id="channel-check-interval" type="number" min="1" step="1" name="checkIntervalMinutes" placeholder="<%= t('channels.intervalPlaceholder') %>"></div>
                <div class="alert alert-danger" data-form-error role="alert" hidden></div>
              </div>
              <div class="modal-footer">
                <button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal"><%= t('common.cancel') %></button>
                <button class="btn btn-primary" type="submit" data-channel-submit><%= t('channels.create') %></button>
              </div>
            </form>
        </div>
      </div>
      <div class="modal fade" id="initial-sync-modal" tabindex="-1" aria-labelledby="initial-sync-title" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered"><form id="initial-sync-form" class="modal-content">
          <div class="modal-header"><h2 class="modal-title h5" id="initial-sync-title"><%= t('channels.initialSync') %></h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="<%= t('common.close') %>"></button></div>
          <div class="modal-body"><label class="form-label" for="initial-sync-months"><%= t('channels.historyRange') %></label><select class="form-select" id="initial-sync-months" name="historyMonths"><option value="1"><%= t('channels.historyMonths.1') %></option><option value="3"><%= t('channels.historyMonths.3') %></option><option value="6"><%= t('channels.historyMonths.6') %></option><option value="12"><%= t('channels.historyMonths.12') %></option></select><div class="alert alert-danger mt-3 mb-0" data-form-error role="alert" hidden></div></div>
          <div class="modal-footer"><button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal"><%= t('common.cancel') %></button><button class="btn btn-primary" type="submit"><%= t('channels.startSync') %></button></div>
        </form></div>
      </div>
    </main>
    <script type="module" src="/public/channels.js"></script>
<%- include('partials/footer') %>
