<%- include('partials/header') %>
      <h1><%= t('page.notifications.title') %></h1>
      <p class="text-body-secondary"><%= t('notifications.summary') %></p>
      <div id="page-error" class="alert alert-danger" hidden></div>
      <button id="mark-all-read" class="btn btn-outline-primary mb-3" type="button" hidden><%= t('notifications.markAllRead') %></button>
      <div class="channel-table-shell table-responsive">
        <table class="table channel-detail-table notification-table align-middle mb-0">
          <thead><tr><th scope="col"><%= t('field.video') %></th><th scope="col"><%= t('field.channel') %></th><th scope="col"><%= t('field.publishedDate') %></th><th scope="col"><%= t('field.createdAt') %></th><th scope="col"><%= t('field.status') %></th><th scope="col"><%= t('field.actions') %></th></tr></thead>
          <tbody id="notification-list" aria-live="polite"></tbody>
        </table>
        <div id="notification-empty-state" class="channel-table-empty p-5 text-center" hidden><%= t('notifications.empty') %></div>
      </div>
      <nav id="notification-pagination" class="list-pagination" aria-label="<%= t('page.notifications.title') %>" hidden></nav>
    </main>
    <script type="module" src="/public/notifications.js"></script>
<%- include('partials/footer') %>
