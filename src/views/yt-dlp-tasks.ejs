<%- include('partials/header') %>
      <div class="yt-dlp-tasks-heading">
        <p class="yt-dlp-tasks-kicker">YT-DLP TASKS</p>
        <h1>任务状态</h1>
        <p>展示当前进程中的 yt-dlp 任务快照。刷新浏览器可查看最新状态。</p>
      </div>
      <div id="page-error" class="alert alert-danger" role="alert" hidden></div>
      <section class="yt-dlp-tasks-section" aria-labelledby="active-tasks-title">
        <div class="yt-dlp-tasks-section-heading">
          <h2 id="active-tasks-title">活动任务</h2>
          <span id="active-task-count" class="badge rounded-pill text-bg-primary">0</span>
        </div>
        <div class="yt-dlp-tasks-table-shell table-responsive">
          <table class="table yt-dlp-tasks-table align-middle mb-0">
            <thead><tr><th scope="col">任务 ID</th><th scope="col">任务类型</th><th scope="col">状态</th><th scope="col">创建时间</th><th scope="col">开始时间</th><th scope="col">结束时间</th><th scope="col">失败原因</th></tr></thead>
            <tbody id="active-task-list"></tbody>
          </table>
          <div id="active-task-empty" class="yt-dlp-tasks-empty" role="status" hidden>当前没有排队或运行中的任务。</div>
        </div>
      </section>
      <section class="yt-dlp-tasks-section" aria-labelledby="terminal-tasks-title">
        <div class="yt-dlp-tasks-section-heading">
          <h2 id="terminal-tasks-title">已结束任务</h2>
          <span id="terminal-task-count" class="badge rounded-pill text-bg-secondary">0</span>
        </div>
        <div class="yt-dlp-tasks-table-shell table-responsive">
          <table class="table yt-dlp-tasks-table align-middle mb-0">
            <thead><tr><th scope="col">任务 ID</th><th scope="col">任务类型</th><th scope="col">状态</th><th scope="col">创建时间</th><th scope="col">开始时间</th><th scope="col">结束时间</th><th scope="col">失败原因</th></tr></thead>
            <tbody id="terminal-task-list"></tbody>
          </table>
          <div id="terminal-task-empty" class="yt-dlp-tasks-empty" role="status" hidden>当前没有已结束的任务。</div>
        </div>
      </section>
    </main>
    <script type="module" src="/public/yt-dlp-tasks.js"></script>
<%- include('partials/footer') %>
