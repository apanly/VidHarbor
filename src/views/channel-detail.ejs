<%- include('partials/header') %>
      <header class="channel-detail-hero position-relative overflow-hidden mb-4" data-channel-id="<%= channelId %>">
        <div class="channel-detail-heading d-flex flex-column flex-md-row align-items-start align-items-md-end justify-content-between gap-4">
          <div>
            <h1 class="mb-0" id="channel-name"><%= t('page.channelDetail.title') %></h1>
          </div>
          <p id="channel-summary" class="channel-detail-summary"><%= t('channelDetail.loading') %></p>
        </div>
      </header>
      <div id="page-error" class="alert alert-danger" hidden></div>

      <div class="channel-detail-tabs nav nav-pills d-flex mb-3" role="tablist" aria-label="<%= t('page.channelDetail.title') %>">
        <button class="channel-detail-tab nav-link active" id="video-tab" type="button" role="tab" aria-selected="true" aria-controls="video-panel" data-channel-tab="videos"><%= t('channelDetail.videos') %></button>
        <button class="channel-detail-tab nav-link" id="check-tab" type="button" role="tab" aria-selected="false" aria-controls="check-panel" data-channel-tab="checks"><%= t('channelDetail.checks') %></button>
      </div>

      <div class="channel-detail-content">
        <section id="video-panel" class="channel-tab-panel" role="tabpanel" aria-labelledby="video-tab" data-channel-panel="videos">
          <form id="download-form">
            <div class="channel-video-toolbar d-grid align-items-end mb-3">
              <div class="channel-proxy-field">
                <label class="form-label" for="channel-download-proxy"><%= t('field.network') %></label>
                <select class="form-select" id="channel-download-proxy" name="proxyId">
                  <option value="channel"><%= t('channelDetail.useChannelProxy') %></option>
                  <option value=""><%= t('common.direct') %></option>
                </select>
              </div>
              <div class="channel-filter-field">
                <label class="form-label" for="channel-video-filter"><%= t('channelDetail.filter') %></label>
                <input class="form-control" id="channel-video-filter" name="filter" placeholder="<%= t('channelDetail.filterPlaceholder') %>">
              </div>
              <div class="channel-selection-action d-grid">
                <span id="selected-video-count"><%= t('channelDetail.selected', { count: 0 }) %></span>
                <button class="btn btn-primary" type="submit" disabled><%= t('channelDetail.downloadSelected') %></button>
              </div>
            </div>
            <div class="alert alert-danger" data-form-error hidden></div>
            <div class="channel-table-shell table-responsive">
              <table class="table channel-detail-table align-middle mb-0">
                <thead><tr><th scope="col" class="channel-select-column text-center"><%= t('channelDetail.select') %></th><th scope="col"><%= t('field.video') %></th><th scope="col"><%= t('field.publishedDate') %></th><th scope="col"><%= t('field.duration') %></th><th scope="col"><%= t('field.status') %></th><th scope="col"><%= t('common.originalUrl') %></th></tr></thead>
                <tbody id="video-list"></tbody>
              </table>
              <div id="video-empty-state" class="channel-table-empty p-5 text-center" hidden></div>
            </div>
            <nav id="video-pagination" class="list-pagination" aria-label="<%= t('channelDetail.videos') %>" hidden></nav>
          </form>
        </section>

        <section id="check-panel" class="channel-tab-panel" role="tabpanel" aria-labelledby="check-tab" data-channel-panel="checks" hidden>
          <div class="channel-table-shell table-responsive">
            <table class="table channel-detail-table channel-check-table align-middle mb-0">
              <thead><tr><th scope="col"><%= t('field.type') %></th><th scope="col"><%= t('field.startedAt') %></th><th scope="col"><%= t('field.finishedAt') %></th><th scope="col"><%= t('field.result') %></th><th scope="col"><%= t('field.video') %></th><th scope="col"><%= t('field.failureReason') %></th></tr></thead>
              <tbody id="check-list"></tbody>
            </table>
            <div id="check-empty-state" class="channel-table-empty p-5 text-center" hidden><%= t('channelDetail.noChecks') %></div>
          </div>
          <nav id="check-pagination" class="list-pagination" aria-label="<%= t('channelDetail.checks') %>" hidden></nav>
        </section>
      </div>
    </main>
    <script type="module" src="/public/channel-detail.js"></script>
<%- include('partials/footer') %>
